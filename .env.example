# BuilderVerse Environment Variables
# ---------------------------------------------------------------------------
# SUPABASE (required for real auth, progress, certificates, multi-user)
# Get values from Supabase dashboard -> Project Settings -> API

# Server-side (Vercel serverless functions use these)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend (browser code uses these - anon key is safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional - AI Mentor (Sprout AI)
GEMINI_API_KEY=your-gemini-api-key-here
